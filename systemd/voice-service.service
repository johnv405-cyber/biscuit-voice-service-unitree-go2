[Unit]
Description=Robot Voice Service - Sensor detection and voice responses
After=network.target

[Service]
Type=simple
ExecStart=/workspaces/biscuit-voice-service-unitree-go2/run_voice_service.sh
WorkingDirectory=/workspaces/biscuit-voice-service-unitree-go2
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=ROBOT_IP=192.168.12.1
Environment=ROBOT_PASSWORD=123
Environment=IDLE_INTERVAL=15

[Install]
WantedBy=multi-user.target
